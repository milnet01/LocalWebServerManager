#!/usr/bin/env bash
# Run the gate before a push that touches anything the gate checks.
#
# CLAUDE.md § Before pushing has required this since 2026-08-03 and nothing
# enforced it, so it held exactly as often as someone remembered. On
# 2026-08-18 five consecutive pushes went red — the first because a tool
# version differed (see scripts/ci-tools.env), the next four because nobody
# noticed the first.
#
# A DOCS-ONLY push runs `local-ci.sh --docs`, not the full gate: eleven seconds
# of pytest between a typo fix and a push is how a team learns to reach for
# --no-verify by reflex. It is decided by the paths in the push, never by the
# commit subject. It is not a skip. Until 2026-09-28 it was, and three gate
# steps read prose: the format check reads every .md, the version lockstep
# reads ROADMAP.md, and the suite reads CONTRIBUTING.md (local-gate.md § 2.1).
#
# Some markdown takes the FULL gate, because the suite asserts against it —
# see docs_only().
#
# Every push is also scanned for secrets first, by the machine-wide hook's
# --secrets-only mode, and neither escape hatch below skips that scan.
#
# Escape hatches for the gate, in order of preference:
#   git push --no-verify          one push, git's own mechanism; skips the scan too
#   LWSM_SKIP_PREPUSH=1 git push  the gate only, when a wrapper eats --no-verify
#
# Enable with:  git config core.hooksPath .githooks
# That is per-clone and cannot be committed, which is why tests/test_ci_contract.py
# checks the file is present and executable rather than that it is active.
set -Eeuo pipefail

cd "$(git rev-parse --show-toplevel)"

# git's stdin, read ONCE: the secret scan and the gate below both need it.
REFS=$(cat)

# security.md § 2: a secret must never reach a remote. The machine-wide hook
# owns the scan (gitleaks over the pushed commits) and --secrets-only runs no
# gate, so this project keeps its own gate and does not copy the scanner. Its
# non-zero exit stops the push, through `set -e`. On a machine without it — CI,
# a colleague's clone — there is no scan, and this says so rather than passing
# in silence.
SHARED_HOOK="${ANTS_GLOBAL_HOOKS:-$HOME/.claude/githooks}/pre-push"
if [[ -x $SHARED_HOOK ]]; then
    # The remote git named, so a branch new to it is scanned against what THAT
    # remote holds — our push_base() below scopes the gate the same way.
    printf '%s\n' "$REFS" | "$SHARED_HOOK" --secrets-only "${1:-}"
else
    printf 'pre-push: NO SECRET SCAN on this machine (%s is absent)\n' "$SHARED_HOOK" >&2
fi

# After the scan, not before it: skipping the gate is the user's call, and a
# secret reaching a remote is never anyone's.
if [[ ${LWSM_SKIP_PREPUSH:-0} == 1 ]]; then
    printf 'pre-push: gate skipped (LWSM_SKIP_PREPUSH=1)\n' >&2
    exit 0
fi

ZERO=0000000000000000000000000000000000000000

# Paths a change to which cannot affect any check the gate runs. Everything
# NOT matched here runs the gate, which is the safe direction: a new top-level
# file is checked until someone decides it need not be.
#
# scripts/ is absent on purpose — it holds the gate itself and the installer,
# both of which shellcheck reads. So is .github/, which actionlint reads.
# The first arm carves back out the markdown the SUITE asserts against. A file
# the gate reads is a gate input whatever its extension, which is the identical
# argument the paragraph above makes for the gate script and the workflow — and
# nobody had made it for prose. On 2026-08-19 a docs-only push edited CLAUDE.md,
# skipped the gate on that basis, and GitHub found the prose count that
# test_docs.py forbids. The list is DERIVED, not copied: the contract test runs
# this very function against test_docs.ASSERTED, so the two cannot part.
# CONTRIBUTING.md is the one addition, since test_ci_contract.py reads it; the
# same test names it beside ASSERTED.
docs_only() {
    local path
    while IFS= read -r path; do
        [[ -z $path ]] && continue
        case $path in
            CLAUDE.md | README.md | CONTRIBUTING.md | docs/standards/*.md) return 1 ;;
            docs/claude/*.md) return 1 ;;
            docs/design-look-and-feel.md | docs/design-accessibility.md) return 1 ;;
            docs/* | .claude/* | *.md | LICENSE) ;;
            *) return 1 ;;
        esac
    done
    return 0
}

# What to diff this ref against, or refusal when the push adds nothing.
#
# Scoped to the remote being pushed to, never to every remote at once
# (LWSM-1269). Asked of `--remotes`, a commit sitting on a backup or a fork
# answers "already published" — so the ref contributed nothing to `changed`,
# added no tip, and the hook could reach "nothing to check" with the gate never
# run, while those commits reach GitHub for the first time. Reproduced with a
# two-remote repo on 2026-09-07.
#
# An empty result now means what it says: the target remote already holds this
# content under some other ref name, so the push sends no commits and there is
# nothing for the gate to check. That is the one exemption here. The unknown
# range the header speaks of is the ROOT-COMMIT case below, which falls back to
# the empty tree rather than skipping.
#
# A push to a bare URL rather than a named remote matches no refs/remotes/*,
# so every commit reads as new and the gate runs. That is the safe direction.
push_base() {
    local local_sha=$1 remote_sha=$2 remote=$3 oldest base

    if [[ $remote_sha != "$ZERO" ]]; then
        printf '%s' "$remote_sha"
        return 0
    fi

    oldest=$(git rev-list "$local_sha" --not "--remotes=$remote" | tail -n 1)
    [[ -z $oldest ]] && return 1

    base="$oldest^"
    git rev-parse --verify --quiet "$base" >/dev/null || base=$(git hash-object -t tree /dev/null)
    printf '%s' "$base"
}

# git names the remote in $1 — the whole point of the scoping above.
REMOTE=${1:-origin}

# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>
changed=""
tips=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
    # Deleting a ref pushes no content; an empty line is no ref at all.
    [[ -z ${local_sha:-} || $local_sha == "$ZERO" ]] && continue

    base=$(push_base "$local_sha" "$remote_sha" "$REMOTE") || continue

    changed+=$(git diff --name-only "$base" "$local_sha")$'\n'
    tips+=("$local_sha")
done <<<"$REFS"

if [[ -z ${changed//[$'\n' ]/} ]]; then
    printf 'pre-push: nothing to check\n' >&2
    exit 0
fi

GATE_ARGS=()
if printf '%s' "$changed" | docs_only; then
    printf 'pre-push: docs-only push, running the documentation checks\n' >&2
    GATE_ARGS=(--docs)
fi

# No --fast, and the runner's environment rather than a developer's. The point
# of this hook is that what runs here is what runs on GitHub. --fast drops the
# integration tests; and without LWSM_REQUIRE_ALL_TOOLS a check that did not
# run, or a tool at a version CI does not install, is a WARNING here and FATAL
# there. Measured 2026-08-21 with actionlint off PATH: the same tree exited 0
# through this hook and 1 under the workflow's environment.
#
# Running the gate BY HAND stays lenient, deliberately — a missing linter must
# not stop someone testing their own change. It is standing in for CI that
# makes a degraded run worth refusing, and that is only true here.
#
# And the gate runs against the COMMITS BEING PUSHED, never against this
# working tree. Those are the same tree only when the tree is clean, and
# nothing here makes it clean: an uncommitted fix turns this run green for
# commits that will go red on GitHub, and unrelated scratch work turns it red
# for commits that were fine. Neither announces itself — the gate prints an
# ordinary verdict either way, about a tree nobody is pushing. The range was
# already on stdin and already decides docs_only above; this is the same range
# deciding the rest. CLAUDE.md § Before pushing names the property; this
# project's docs/standards/commits.md has no section on the local run at all,
# so do not go looking for one there.
#
# A detached worktree rather than a stash. `git stash` exits 0 having stashed
# nothing when there is nothing to stash, so a hook cannot tell a clean tree
# from a failed one; it also mutates the tree mid-hook, and the `pop` then has
# to survive a gate that may have just exited non-zero. Measured 2026-08-21:
# the checkout and `uv sync` cost 5.2s against the gate's own runtime.
WORKTREE=""
cleanup() {
    # Not `rm -rf` as a fallback: WORKTREE is a mktemp path and git empties it,
    # so anything left is a git failure worth seeing rather than hiding. Shown,
    # and never fatal: this runs after a green gate, and under `set -e` a
    # failed remove refused the push with exit 128 and no message (LWSM-1284).
    [[ -z $WORKTREE ]] || git worktree remove --force "$WORKTREE" ||
        printf 'pre-push: could not remove worktree %s\n' "$WORKTREE" >&2
    return 0
}
trap cleanup EXIT

for tip in "${tips[@]}"; do
    printf 'pre-push: running ./scripts/local-ci.sh%s against %s\n' \
        "${GATE_ARGS[*]:+ ${GATE_ARGS[*]}}" "${tip:0:12}" >&2
    WORKTREE=$(mktemp -d)
    git worktree add --detach --quiet "$WORKTREE" "$tip"
    # The subshell keeps the cd local, so cleanup above still runs from the
    # repo root where `git worktree remove` has to be invoked.
    ( cd "$WORKTREE" && LWSM_REQUIRE_ALL_TOOLS=1 ./scripts/local-ci.sh "${GATE_ARGS[@]}" )
    cleanup
    WORKTREE=""
done
