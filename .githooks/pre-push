#!/usr/bin/env bash
# Run the gate before a push that touches anything the gate checks.
#
# CLAUDE.md § Before pushing has required this since 2026-08-03 and nothing
# enforced it, so it held exactly as often as someone remembered. On
# 2026-08-18 five consecutive pushes went red — the first because a tool
# version differed (see scripts/ci-tools.env), the next four because nobody
# noticed the first.
#
# A DOCS-ONLY push is exempt, deliberately: the gate has mostly nothing to say
# about prose, and eleven seconds of pytest between a typo fix and a push is how
# a team learns to reach for --no-verify by reflex. The exemption is decided by
# the paths in the push, never by the commit subject.
#
# "Mostly" is load-bearing. Some markdown IS a gate input, and the exemption
# below carves those files back out — see docs_only().
#
# Escape hatches, in order of preference:
#   git push --no-verify          one push, git's own mechanism
#   LWSM_SKIP_PREPUSH=1 git push  same, when a wrapper eats --no-verify
#
# Enable with:  git config core.hooksPath .githooks
# That is per-clone and cannot be committed, which is why tests/test_hooks.py
# checks the file is present and executable rather than that it is active.
set -Eeuo pipefail

if [[ ${LWSM_SKIP_PREPUSH:-0} == 1 ]]; then
    printf 'pre-push: skipped (LWSM_SKIP_PREPUSH=1)\n' >&2
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

ZERO=0000000000000000000000000000000000000000

# Paths a change to which cannot affect any check the gate runs. Everything
# NOT matched here runs the gate, which is the safe direction: a new top-level
# file is checked until someone decides it need not be.
#
# scripts/ is absent on purpose — it holds the gate itself and the installer,
# both of which shellcheck reads. So is .github/, which actionlint reads.
# The first arm carves back out the markdown the SUITE asserts against. A file
# the gate reads is a gate input whatever its extension, which is the identical
# argument the paragraph above makes for the gate script and the workflow — and
# nobody had made it for prose. On 2026-08-19 a docs-only push edited CLAUDE.md,
# skipped the gate on that basis, and GitHub found the prose count that
# test_docs.py forbids. The list is DERIVED, not copied: the contract test runs
# this very function against test_docs.GOVERNED, so the two cannot part.
docs_only() {
    local path
    while IFS= read -r path; do
        [[ -z $path ]] && continue
        case $path in
            CLAUDE.md | README.md | docs/standards/*.md) return 1 ;;
            docs/* | .claude/* | *.md | LICENSE) ;;
            *) return 1 ;;
        esac
    done
    return 0
}

# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>
changed=""
tips=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
    # Deleting a ref pushes no content.
    [[ $local_sha == "$ZERO" ]] && continue

    if [[ $remote_sha == "$ZERO" ]]; then
        # A branch the remote has never seen: there is no "since" to diff
        # against, so ask which commits are not already on some remote and
        # diff from the oldest one's parent. If that cannot be resolved we
        # run the gate — an unknown range is not an exemption.
        oldest=$(git rev-list "$local_sha" --not --remotes | tail -n 1)
        if [[ -z $oldest ]]; then
            continue
        fi
        base="$oldest^"
        git rev-parse --verify --quiet "$base" >/dev/null || base=$(git hash-object -t tree /dev/null)
    else
        base="$remote_sha"
    fi

    changed+=$(git diff --name-only "$base" "$local_sha")$'\n'
    tips+=("$local_sha")
done

if [[ -z ${changed//[$'\n' ]/} ]]; then
    printf 'pre-push: nothing to check\n' >&2
    exit 0
fi

if printf '%s' "$changed" | docs_only; then
    printf 'pre-push: docs-only push, gate not required\n' >&2
    exit 0
fi

# No --fast, and the runner's environment rather than a developer's. The point
# of this hook is that what runs here is what runs on GitHub. --fast drops the
# integration tests; and without LWSM_REQUIRE_ALL_TOOLS a check that did not
# run, or a tool at a version CI does not install, is a WARNING here and FATAL
# there. Measured 2026-08-21 with actionlint off PATH: the same tree exited 0
# through this hook and 1 under the workflow's environment.
#
# Running the gate BY HAND stays lenient, deliberately — a missing linter must
# not stop someone testing their own change. It is standing in for CI that
# makes a degraded run worth refusing, and that is only true here.
#
# And the gate runs against the COMMITS BEING PUSHED, never against this
# working tree. Those are the same tree only when the tree is clean, and
# nothing here makes it clean: an uncommitted fix turns this run green for
# commits that will go red on GitHub, and unrelated scratch work turns it red
# for commits that were fine. Neither announces itself — the gate prints an
# ordinary verdict either way, about a tree nobody is pushing. The range was
# already on stdin and already decides docs_only above; this is the same range
# deciding the rest. CLAUDE.md § Before pushing names the property; this
# project's docs/standards/commits.md has no section on the local run at all,
# so do not go looking for one there.
#
# A detached worktree rather than a stash. `git stash` exits 0 having stashed
# nothing when there is nothing to stash, so a hook cannot tell a clean tree
# from a failed one; it also mutates the tree mid-hook, and the `pop` then has
# to survive a gate that may have just exited non-zero. Measured 2026-08-21:
# the checkout and `uv sync` cost 5.2s against the gate's own runtime.
WORKTREE=""
cleanup() {
    [[ -n $WORKTREE ]] && git worktree remove --force "$WORKTREE" 2>/dev/null
    # Not `rm -rf` as a fallback: WORKTREE is a mktemp path and git empties it,
    # so anything left is a git failure worth seeing rather than hiding.
    return 0
}
trap cleanup EXIT

for tip in "${tips[@]}"; do
    printf 'pre-push: running ./scripts/local-ci.sh against %s\n' "${tip:0:12}" >&2
    WORKTREE=$(mktemp -d)
    git worktree add --detach --quiet "$WORKTREE" "$tip"
    # The subshell keeps the cd local, so cleanup above still runs from the
    # repo root where `git worktree remove` has to be invoked.
    ( cd "$WORKTREE" && LWSM_REQUIRE_ALL_TOOLS=1 ./scripts/local-ci.sh )
    cleanup
    WORKTREE=""
done
